# Copy this file to .env.local and fill in the values.
# On Vercel/Netlify, add the same variables in the project settings.

# Firebase: Console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://farhan-thinks-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google account allowed to manage posts (must match database.rules.json)
NEXT_PUBLIC_ADMIN_EMAIL=

# Server-side comment/contact protection (create a Redis database at Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase Admin service account JSON for server-side comment writes
FIREBASE_SERVICE_ACCOUNT_JSON=

# Contact form: server-side access key from https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# URL used for share links and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
